/*
!/sun_miss0_recov/
!/sun_miss1_recov/
!/.gitignore

**/__pycache__/
*.pyc
**/runs/
**/runs_v2/
**/runs_v3/
**/diagnose_out/
*.log
*.pt
*.pth
*.ckpt
*.npy
*.npz
